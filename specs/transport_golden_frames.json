{
  "protocol_version": 1,
  "frozen": true,
  "note": "Frozen cross-language encodings, at two layers: frame cases pin the framing, message cases pin the typed field names and types. Every implementation must encode each case to exactly these bytes and decode them back to these fields. Changing a recorded byte is a protocol change and needs a version bump; ADDING a case is not, since it constrains nothing already agreed -- but because regeneration rewrites the whole file, a test checks every pre-existing case is byte-identical.",
  "payload_generator": "payload[i] = (i * 37 + 11) % 256",
  "byte_order": "big-endian",
  "header_encoding": "UTF-8 JSON object, keys sorted recursively, separators ',' and ':', no non-ASCII escaping, NaN and Infinity rejected",

*.sif
*.ext3
HighwayEnv-sourcecode/
logs/
outputs/
__pycache__/
texmf/
texmf-config/
texmf-var/
.venv/


# Android phone app (section E)
phone/.gradle/
phone/build/
phone/*/build/
phone/local.properties
phone/.kotlin/
.remutate-restore

# Test-run output. Rewritten by every pytest invocation, so tracking it left the
# tree dirty during mutation runs -- which is how a mutant gets committed by accident.
build/

# Device-test artifacts: a session log is megabytes of frame headers and is
# regenerated by any run. Kept on disk, out of the history.
# device-test-*/ held one real session and is committed; later ones are not.
device-test-*/
!device-test-2026-08-25/

# Mainz scenario inputs and the network built from them. The .inpx comes from
# ankitbha/Self-Regulating-Cars and is that repository's artifact, not ours; the
# .net.xml and route files are generated by scripts/build_mainz_scenario.py. Kept on
# disk, out of git, like every other harness data file.
# data/mainz is committed in full: the .inpx input, and the network and routes built
# from it. The built files are regenerable, but committing them pins the exact scenario
# the results came from -- a three-into-two exit lane drop at a sustained 4,500 veh/h.
# Rebuilding with different arguments will show as a diff, which is the point.
data/tree/

# LaTeX build products. The source is tracked; the artifacts are rebuilt by any run,
# and a stale .aux from a different document class breaks the next build.
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.pdf
paper/missfont.log
